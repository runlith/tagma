      "svelte": "5.57.0",
      "svelte-check": "^4.7.7",
      "tailwindcss": "^4.3.3",
      "vite": "^8.2.2",
      "vitest": "^4.1.11",
      "ws": "^8.21.0",
      "uuid": "^14.0.0",
