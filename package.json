      "shiki": "^4.3.0",
      "sharp": "^0.34.5"
    }
  },
  "type": "module",
  "scripts": {
    "check:change": "bun scripts/change/check.ts",
    "test:all": "testbed bun scripts/change/all.ts",
    "test:e2e": "testbed e2e --no-isolate",
    "typecheck": "runlith-typecheck scripts",
    "patches:prove": "bun scripts/patches-prove.mjs",
    "test:integration": "testbed bun test $(find checks -path checks/law -prune -o -name '*.itest.ts' -print | sed 's|^|./|')",
    "effect:lint": "bun checks/effect/lint.ts",
    "tagma:build": "bun run --cwd apps/tagma/server build",
    "tagma:release": "bun run --cwd apps/tagma/server release",
    "tagma:restart": "bun run --cwd apps/tagma/server restart",
    "tagma:stack": "bun run --cwd apps/tagma/server stack",
    "tagma:try": "bun run --cwd apps/tagma/server try",
    "tagma:transition": "bun run --cwd apps/tagma/server transition",
    "tagma:typecheck": "runlith-typecheck apps/tagma && bun test ./apps/tagma/server/src/threads/doctrine/sectionText.test.ts ./apps/tagma/server/src/threads/doctrine/render.test.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@runlith/tagma": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@tagma/inspection": "workspace:*",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.86.0",
    "svelte": "catalog:",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "6.0.3",
    "zod": "catalog:"
  },
  "overrides": {
    "@codemirror/view": "6.43.14"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "effect@4.0.1": "patches/effect@4.0.1.patch",
    "@effect/platform-bun@4.0.1": "patches/@effect%2Fplatform-bun@4.0.1.patch",
    "@effect/platform-node-shared@4.0.1": "patches/@effect%2Fplatform-node-shared@4.0.1.patch",
    "svelte@5.57.0": "patches/svelte@5.57.0.patch",
    "@xterm/headless@6.1.0-beta.302": "patches/@xterm%2Fheadless@6.1.0-beta.302.patch",
    "@xterm/xterm@6.1.0-beta.303": "patches/@xterm%2Fxterm@6.1.0-beta.303.patch",
    "@xterm/addon-webgl@0.20.0-beta.299": "patches/@xterm%2Faddon-webgl@0.20.0-beta.299.patch",
    "@xterm/addon-serialize@0.15.0-beta.300": "patches/@xterm%2Faddon-serialize@0.15.0-beta.300.patch",
    "@xterm/addon-ligatures@0.11.0-beta.300": "patches/@xterm%2Faddon-ligatures@0.11.0-beta.300.patch",
    "svelte-check@4.7.7": "patches/svelte-check@4.7.7.patch",
    "@effect-vfs/memory@0.9.0": "patches/@effect-vfs%2Fmemory@0.9.0.patch",
    "@tanstack/virtual-core@3.19.8": "patches/@tanstack%2Fvirtual-core@3.19.8.patch"
  },
