{
  "name": "@tagma/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tagma's desktop host: one Electron window over the surface the local server hands out.",
  "type": "module",
  "main": "dist/app/main.mjs",
  "exports": {
    "./bridge": {
      "types": "./src/bridge.ts",
      "browser": "./src/bridge.ts",
      "node": "./src/bridge.ts",
      "default": "./src/bridge.ts"
    }
  },
  "scripts": {
    "build": "bun ./scripts/build-host.ts",
    "dev": "bun ./scripts/dev.ts",
    "icon": "bun ./scripts/icon.ts",
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "test:integration": "bun -e \"require('electron')\" && bun run --cwd ../../../packages/execution-host build:native && testbed itest --no-isolate",
    "test:e2e": "testbed e2e",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/cdp": "workspace:*",
    "@runlith/desktop-host": "workspace:*",
    "@runlith/desktop-input": "workspace:*",
    "@runlith/window-behavior": "workspace:*",
    "@tagma/server": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@electron/get": "5.1.0",
    "@runlith/bundle": "workspace:*",
    "@runlith/codesign": "workspace:*",
    "@runlith/dev-runner": "workspace:*",
    "@runlith/e2e": "workspace:*",
    "@runlith/effect-test": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "electron": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
