{
  "name": "@tagma/inspection",
  "version": "0.1.0",
  "private": true,
  "description": "Tagma's inspections: a core engine that judges a change against its base, and rule packs by technology collected from their manifests — a browser-safe vocabulary door and Node doors that load a pack's readings on demand.",
  "type": "module",
  "exports": {
    "./builtins": {
      "types": "./src/builtins.ts",
      "browser": "./src/builtins.ts",
      "node": "./src/builtins.ts",
      "default": "./src/builtins.ts"
    },
    "./rule": {
      "types": "./src/core/rule.ts",
      "browser": "./src/core/rule.ts",
      "node": "./src/core/rule.ts",
      "default": "./src/core/rule.ts"
    },
    "./signature": {
      "types": "./src/core/signature.ts",
      "browser": "./src/core/signature.ts",
      "node": "./src/core/signature.ts",
      "default": "./src/core/signature.ts"
    },
    "./program": {
      "types": "./src/core/program.ts",
      "browser": "./src/core/program.ts",
      "node": "./src/core/program.ts",
      "default": "./src/core/program.ts"
    },
    "./verdict": {
      "types": "./src/core/verdict.ts",
      "browser": "./src/core/verdict.ts",
      "node": "./src/core/verdict.ts",
      "default": "./src/core/verdict.ts"
    },
    "./node/builtins": {
      "types": "./src/builtins.node.ts",
      "default": "./src/builtins.node.ts"
    },
    "./node/implementations": {
      "types": "./src/core/node/implementations.ts",
      "default": "./src/core/node/implementations.ts"
    },
    "./node/reading": {
      "types": "./src/core/node/reading.ts",
      "default": "./src/core/node/reading.ts"
    },
    "./node/judge": {
      "types": "./src/core/node/judge.ts",
      "default": "./src/core/node/judge.ts"
    },
    "./node/memo": {
      "types": "./src/core/node/memo.ts",
      "default": "./src/core/node/memo.ts"
    },
    "./node/budget": {
      "types": "./src/core/node/budget.ts",
      "default": "./src/core/node/budget.ts"
    },
    "./node/slices": {
      "types": "./src/core/node/slices.ts",
      "default": "./src/core/node/slices.ts"
    },
    "./node/runners/oxlint": {
      "types": "./src/runners/oxlint/adapter.ts",
      "default": "./src/runners/oxlint/adapter.ts"
    },
    "./node/runners/files": {
      "types": "./src/runners/files/counts.ts",
      "default": "./src/runners/files/counts.ts"
    },
    "./node/runners/version": {
      "types": "./src/runners/files/version.ts",
      "default": "./src/runners/files/version.ts"
    },
    "./node/runners/eslint": {
      "types": "./src/runners/eslint/adapter.ts",
      "default": "./src/runners/eslint/adapter.ts"
    },
    "./node/runners/eslint/driver": {
      "types": "./src/runners/eslint/driver.ts",
      "default": "./src/runners/eslint/driver.ts"
    },
    "./node/runners/ruff": {
      "types": "./src/runners/ruff/adapter.ts",
      "default": "./src/runners/ruff/adapter.ts"
    },
    "./node/runners/ast-grep": {
      "types": "./src/runners/ast-grep/adapter.ts",
      "default": "./src/runners/ast-grep/adapter.ts"
    },
    "./node/runners/semgrep": {
      "types": "./src/runners/semgrep/adapter.ts",
      "default": "./src/runners/semgrep/adapter.ts"
    },
    "./node/runners/command": {
      "types": "./src/runners/command/adapter.ts",
      "default": "./src/runners/command/adapter.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate",
    "test:integration": "testbed itest --no-isolate",
    "bench:modules": "bun src/packs/architecture/modules/implementation.bench.ts",
    "bench:names": "bun src/packs/architecture/names/implementation.bench.ts",
    "inspect": "bun src/cli/inspect.ts",
    "inspect:head": "bun src/cli/pinned.ts",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/code-facts": "workspace:*",
    "effect": "catalog:",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@types/bun": "catalog:"
  }
}
