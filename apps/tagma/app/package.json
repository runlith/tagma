{
  "name": "@tagma/app",
  "version": "0.1.0",
  "private": true,
  "description": "Tagma reading surface: the project outline, block cards and the mindmap.",
  "type": "module",
  "exports": {
    "./surfaceConfig": {
      "types": "./scripts/surfaceConfig.ts",
      "default": "./scripts/surfaceConfig.ts"
    },
    "./composition": {
      "types": "./src/lib/app/composition.ts",
      "browser": "./src/lib/app/composition.ts",
      "default": "./src/lib/app/composition.ts"
    },
    "./points/surfaces": {
      "types": "./src/lib/features/workspace/surface.ts",
      "browser": "./src/lib/features/workspace/surface.ts",
      "default": "./src/lib/features/workspace/surface.ts"
    },
    "./points/columns": {
      "types": "./src/lib/features/workspace/column.ts",
      "browser": "./src/lib/features/workspace/column.ts",
      "default": "./src/lib/features/workspace/column.ts"
    },
    "./points/actions": {
      "types": "./src/lib/features/workspace/action.ts",
      "browser": "./src/lib/features/workspace/action.ts",
      "default": "./src/lib/features/workspace/action.ts"
    },
    "./points/panes": {
      "types": "./src/lib/shared/panes/pane.ts",
      "browser": "./src/lib/shared/panes/pane.ts",
      "default": "./src/lib/shared/panes/pane.ts"
    },
    "./points/links": {
      "types": "./src/lib/features/opening/Link.ts",
      "browser": "./src/lib/features/opening/Link.ts",
      "default": "./src/lib/features/opening/Link.ts"
    },
    "./points/settings": {
      "types": "./src/lib/features/settings/section.ts",
      "browser": "./src/lib/features/settings/section.ts",
      "default": "./src/lib/features/settings/section.ts"
    },
    "./points/threads": {
      "types": "./src/lib/features/threads/native/contribution.ts",
      "browser": "./src/lib/features/threads/native/contribution.ts",
      "default": "./src/lib/features/threads/native/contribution.ts"
    },
    "./points/records": {
      "types": "./src/lib/features/threads/native/records.ts",
      "browser": "./src/lib/features/threads/native/records.ts",
      "default": "./src/lib/features/threads/native/records.ts"
    },
    "./points/creation": {
      "types": "./src/lib/app/chrome/creation.ts",
      "browser": "./src/lib/app/chrome/creation.ts",
      "default": "./src/lib/app/chrome/creation.ts"
    },
    "./points/wire": {
      "types": "./src/lib/wire/WireEntryKinds.ts",
      "browser": "./src/lib/wire/WireEntryKinds.ts",
      "default": "./src/lib/wire/WireEntryKinds.ts"
    },
    "./ui/*.svelte": {
      "types": "./src/lib/shared/ui/*.svelte",
      "browser": "./src/lib/shared/ui/*.svelte",
      "svelte": "./src/lib/shared/ui/*.svelte",
      "default": null
    },
    "./ui/*": {
      "types": "./src/lib/shared/ui/*/index.ts",
      "browser": "./src/lib/shared/ui/*/index.ts",
      "svelte": "./src/lib/shared/ui/*/index.ts",
      "default": null
    }
  },
  "scripts": {
    "build": "bun run --bun vite build",
    "dev": "bun scripts/dev.ts",
    "dev:restart": "bun scripts/dev.ts --replace-server",
    "prepare": "TAGMA_SURFACE_OUT= bun run --bun svelte-kit sync",
    "preview": "bun run --bun vite preview",
    "test": "testbed bun run --bun vitest run --project 'unit*'",
    "test:integration": "testbed bun run --bun vitest run --project integration",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/agent": "workspace:*",
    "@runlith/builtin-catalog": "workspace:*",
    "@runlith/bundle": "workspace:*",
    "@runlith/chat-ui": "workspace:*",
    "@runlith/code-editor": "workspace:*",
    "@runlith/dev-runner": "workspace:*",
    "@runlith/error-boundary": "workspace:*",
    "@runlith/executions": "workspace:*",
    "@runlith/highlight": "workspace:*",
    "@runlith/layer": "workspace:*",
    "@runlith/llm": "workspace:*",
    "@runlith/markdown": "workspace:*",
    "@runlith/markdown-editor": "workspace:*",
    "@runlith/mcp": "workspace:*",
    "@runlith/primitives": "workspace:*",
    "@runlith/query": "workspace:*",
    "@runlith/roster": "workspace:*",
    "@runlith/seam": "workspace:*",
    "@runlith/search-text": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "@runlith/testing": "workspace:*",
    "@runlith/utils": "workspace:*",
    "@runlith/virtual-list": "workspace:*",
    "@runlith/vite-browser-guard": "workspace:*",
    "@tagma/server": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "@tiptap/core": "catalog:",
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-ligatures": "0.11.0-beta.300",
    "@xterm/addon-search": "0.17.0-beta.300",
    "@xterm/addon-serialize": "0.15.0-beta.300",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/addon-web-links": "0.13.0-beta.300",
    "@xterm/addon-webgl": "0.20.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.303",
    "effect": "catalog:",
    "marked": "catalog:",
    "svelte": "catalog:",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.16.0",
    "@runlith/effect-test": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tagma/desktop": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "clsx": "catalog:",
    "fake-indexeddb": "6.2.5",
    "material-icon-theme": "5.39.0",
    "svelte-check": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
