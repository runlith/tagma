{
  "name": "@tagma/app",
  "version": "0.1.0",
  "private": true,
  "description": "Tagma reading surface: the project outline, block cards and the mindmap.",
  "type": "module",
  "scripts": {
    "build": "bun run --bun vite build",
    "dev": "bun scripts/dev.ts",
    "dev:restart": "bun scripts/dev.ts --replace-server",
    "prepare": "TAGMA_SURFACE_OUT= bun run --bun svelte-kit sync",
    "preview": "bun run --bun vite preview",
    "test": "testbed bun run --bun vitest run --project 'unit*'",
    "test:integration": "testbed bun run --bun vitest run --project integration",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/agent": "workspace:*",
    "@runlith/builtin-catalog": "workspace:*",
    "@runlith/chat-ui": "workspace:*",
    "@runlith/code-editor": "workspace:*",
    "@runlith/dev-runner": "workspace:*",
    "@runlith/error-boundary": "workspace:*",
    "@runlith/executions": "workspace:*",
    "@runlith/highlight": "workspace:*",
    "@runlith/layer": "workspace:*",
    "@runlith/llm": "workspace:*",
    "@runlith/markdown": "workspace:*",
    "@runlith/markdown-editor": "workspace:*",
    "@runlith/mcp": "workspace:*",
    "@runlith/primitives": "workspace:*",
    "@runlith/query": "workspace:*",
    "@runlith/seam": "workspace:*",
    "@runlith/search-text": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "@runlith/testing": "workspace:*",
    "@runlith/utils": "workspace:*",
    "@runlith/virtual-list": "workspace:*",
    "@runlith/vite-browser-guard": "workspace:*",
    "@tagma/server": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "@tiptap/core": "catalog:",
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-ligatures": "0.11.0-beta.300",
    "@xterm/addon-search": "0.17.0-beta.300",
    "@xterm/addon-serialize": "0.15.0-beta.300",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/addon-web-links": "0.13.0-beta.300",
    "@xterm/addon-webgl": "0.20.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.303",
    "effect": "catalog:",
    "marked": "catalog:",
    "svelte": "catalog:",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.16.0",
    "@runlith/bundle": "workspace:*",
    "@runlith/effect-test": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tagma/desktop": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "clsx": "catalog:",
    "fake-indexeddb": "6.2.5",
    "material-icon-theme": "5.39.0",
    "svelte-check": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
