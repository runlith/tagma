import { Effect, Schema } from 'effect';
import { defineAdapter } from '@runlith/tagma/adapter/provider';
import { AccountKey } from '@runlith/llm/models/authStatus';
import { subscriptionToken } from '@runlith/llm/profiles/credential';
import { subscriptionAccounts } from '@runlith/llm/oauth/vendor';
import { route } from '@runlith/llm/protocols/openai-compatible-chat';
import { generateImages } from '@runlith/llm/protocols/openai-images';
import { checkedImageRequest } from '@runlith/llm/profiles/images';
import type { ImageModelSpec } from '@runlith/llm/models/description';
import { QuotaUnsupported } from '@runlith/llm/schema/quota';

const IMAGE_MODEL: ImageModelSpec = { label: '__NAME__ Image', inputs: 0, inputTypes: [], transparent: false };

const credential = Schema.Struct({ accessToken: Schema.String, refreshToken: Schema.NullOr(Schema.String), expiresAt: Schema.NullOr(Schema.Number) });
const accounts = subscriptionAccounts({
  credential,
  signIns: [{ kind: 'key', store: (key) => Effect.succeed({ accessToken: key, refreshToken: null, expiresAt: null }) }],
  key: () => AccountKey.make('only'),
  label: () => '__NAME__',
});

export const adapter = defineAdapter(() => [{
  id: '__NAME__',
  label: '__NAME__',
  kind: 'wire',
  auth: 'oauth',
  accounts,
  models: {
    '__NAME__-1': { label: '__NAME__ 1', capacity: { context: 8192, output: 1024 }, capabilities: ['text'], reasoning: [], defaultReasoning: null },
  },
  imageModels: { '__NAME__-image': IMAGE_MODEL },
  defaultTextModel: '__NAME__-1',
  cacheLifetime: { promisedSeconds: null, prior: null },
  profile: {
    model: (selection) => Effect.succeed(route.with({
      provider: '__NAME__',
      endpoint: { baseURL: 'https://example.invalid/v1' },
      auth: subscriptionToken(selection.credentials, selection.ownerId, '__NAME__', selection.account).bearer(),
      limits: { context: 8192, output: 1024 },
    }).model({ id: selection.model })),
    options: () => undefined,
    output: { budget: 1024, sent: true },
  },
  images: {
    generate: (selection, request) =>
      checkedImageRequest(IMAGE_MODEL, request).pipe(
        Effect.andThen(
          generateImages(
            {
              baseURL: 'https://example.invalid/v1',
              auth: subscriptionToken(selection.credentials, selection.ownerId, '__NAME__', selection.account).bearer(),
              recover: undefined,
              fields: {},
            },
            request,
          ),
        ),
      ),
    quota: () => null,
  },
  quota: { read: () => Effect.fail(new QuotaUnsupported()), fromHeaders: () => null },
}]);
