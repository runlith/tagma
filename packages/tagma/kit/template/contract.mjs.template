import assert from 'node:assert/strict';
import { fileURLToPath } from 'node:url';
import { runConformance } from '@runlith/tagma/adapter/conformance';

const PICTURE = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==';

const result = await runConformance(fileURLToPath(new URL('.', import.meta.url)), {
  host: { product: { mcpServer: 'contract', client: { name: 'contract', version: 'test' } }, instances: [] },
  provider: '__NAME__',
  signIn: { kind: 'key', input: 'local-fixture' },
  expectedText: 'hello',
  respond(request, phase) {
    assert.equal(request.headers.authorization, 'Bearer local-fixture');
    if (phase === 'image') {
      assert.equal(request.url, 'https://example.invalid/v1/images/generations');
      return new Response(JSON.stringify({ data: [{ b64_json: PICTURE }], output_format: 'png' }), { headers: { 'content-type': 'application/json' } });
    }
    assert.equal(request.url, 'https://example.invalid/v1/chat/completions');
    if (phase === 'failure') return new Response(JSON.stringify({ error: { message: 'local refusal', type: 'authentication_error' } }), { status: 401 });
    const frames = [
      { id: 'reply', choices: [{ index: 0, delta: { role: 'assistant', content: 'hello' }, finish_reason: null }] },
      { id: 'reply', choices: [{ index: 0, delta: {}, finish_reason: 'stop' }], usage: { prompt_tokens: 1, completion_tokens: 1 } },
    ];
    return new Response(`${frames.map((frame) => `data: ${JSON.stringify(frame)}\n\n`).join('')}data: [DONE]\n\n`, { headers: { 'content-type': 'text/event-stream' } });
  },
});
assert.equal(result.provider, '__NAME__');
console.log(JSON.stringify({ provider: result.provider, model: result.model, text: result.text, failure: result.failure._tag, image: result.image?.mediaType ?? null }));
