{
  "name": "@runlith/tagma",
  "version": "0.1.0",
  "private": true,
  "description": "The public contract of Tagma: rules a repository declares in tagma.config.ts and the adapter a model provider is written against.",
  "bin": {
    "create": "./kit/create.ts",
    "tagma-plugin": "./src/plugin/cli.ts"
  },
  "type": "module",
  "exports": {
    "./rules": {
      "types": "./src/rules/rules.ts",
      "default": "./src/rules/rules.ts"
    },
    "./rules/effect": {
      "types": "./src/rules/effect.ts",
      "default": "./src/rules/effect.ts"
    },
    "./sources": {
      "types": "./src/rules/sources.ts",
      "bun": "./src/rules/sources.ts",
      "default": null
    },
    "./adapter/provider": {
      "types": "./src/adapter/provider.ts",
      "browser": "./src/adapter/provider.ts",
      "bun": "./src/adapter/provider.ts",
      "default": "./src/adapter/provider.ts"
    },
    "./adapter/harness": {
      "types": "./src/adapter/harness.ts",
      "browser": "./src/adapter/harness.ts",
      "node": "./src/adapter/harness.ts",
      "bun": "./src/adapter/harness.ts",
      "default": "./src/adapter/harness.ts"
    },
    "./adapter/metadata": {
      "types": "./src/adapter/metadata.ts",
      "bun": "./src/adapter/metadata.ts",
      "default": "./src/adapter/metadata.ts"
    },
    "./adapter/hook": {
      "types": "./src/adapter/hook.ts",
      "browser": "./src/adapter/hook.ts",
      "bun": "./src/adapter/hook.ts",
      "default": "./src/adapter/hook.ts"
    },
    "./adapter/payload": {
      "types": "./src/adapter/payload.ts",
      "browser": "./src/adapter/payload.ts",
      "bun": "./src/adapter/payload.ts",
      "default": "./src/adapter/payload.ts"
    },
    "./adapter/claude-hooks": {
      "types": "./src/adapter/claudeHooks.ts",
      "browser": "./src/adapter/claudeHooks.ts",
      "bun": "./src/adapter/claudeHooks.ts",
      "default": "./src/adapter/claudeHooks.ts"
    },
    "./adapter/settings": {
      "types": "./src/adapter/settings.ts",
      "browser": "./src/adapter/settings.ts",
      "bun": "./src/adapter/settings.ts",
      "default": "./src/adapter/settings.ts"
    },
    "./adapter/speech": {
      "types": "./src/adapter/speech.ts",
      "bun": "./src/adapter/speech.ts",
      "default": "./src/adapter/speech.ts"
    },
    "./adapter/loader": {
      "types": "./src/adapter/loader.ts",
      "bun": "./src/adapter/loader.ts",
      "default": null
    },
    "./adapter/declaration": {
      "types": "./src/adapter/declaration.ts",
      "default": "./src/adapter/declaration.ts"
    },
    "./adapter/conformance": {
      "types": "./kit/conformance.ts",
      "bun": "./kit/conformance.ts",
      "default": null
    },
    "./adapter/create": {
      "types": "./kit/create.ts",
      "bun": "./kit/create.ts",
      "default": null
    },
    "./adapter/host-modules": {
      "types": "./src/adapter/hostModules.ts",
      "bun": "./src/adapter/hostModules.ts",
      "default": null
    },
    "./plugin": {
      "types": "./src/plugin/plugin.ts",
      "browser": "./src/plugin/plugin.ts",
      "default": "./src/plugin/plugin.ts"
    },
    "./plugin/bundling": {
      "types": "./src/plugin/bundling.ts",
      "bun": "./src/plugin/bundling.ts",
      "default": null
    },
    "./plugin/process": {
      "types": "./src/plugin/process.ts",
      "bun": "./src/plugin/process.ts",
      "default": null
    },
    "./plugin/protocol": {
      "types": "./src/plugin/protocol.ts",
      "default": "./src/plugin/protocol.ts"
    },
    "./plugin/value": {
      "types": "./src/plugin/value.ts",
      "browser": "./src/plugin/value.ts",
      "default": "./src/plugin/value.ts"
    },
    "./plugin/points": {
      "types": "./src/plugin/points.generated.ts",
      "default": "./src/plugin/points.generated.ts"
    },
    "./plugin/template": {
      "types": "./src/plugin/template.ts",
      "default": "./src/plugin/template.ts"
    },
    "./ui": {
      "types": "./src/plugin/ui.generated.d.ts",
      "default": "./src/plugin/ui.generated.d.ts"
    },
    "./testing": {
      "types": "./src/plugin/testing.ts",
      "bun": "./src/plugin/testing.ts",
      "default": null
    }
  },
  "scripts": {
    "build": "bun kit/build.ts",
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "test:integration": "testbed itest --no-isolate",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@runlith/adapter-anthropic": "workspace:*",
    "@runlith/adapter-deepseek": "workspace:*",
    "@runlith/adapter-devin": "workspace:*",
    "@runlith/adapter-google": "workspace:*",
    "@runlith/adapter-muse": "workspace:*",
    "@runlith/adapter-openai": "workspace:*",
    "@runlith/adapter-opencode-go": "workspace:*",
    "@runlith/adapter-stepfun": "workspace:*",
    "@runlith/adapter-xai": "workspace:*",
    "@runlith/agent": "workspace:*",
    "@runlith/held": "workspace:*",
    "@runlith/llm": "workspace:*",
    "@runlith/mcp": "workspace:*",
    "@runlith/speech": "workspace:*",
    "@runlith/utils": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/oxide": "catalog:",
    "svelte": "catalog:",
    "svelte2tsx": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@runlith/tsconfig": "workspace:*",
    "@tagma/inspection": "workspace:*",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.1"
  },
  "changeCheck": {
    "loads": {
      "src/adapter/loader.ts": []
    }
  },
  "tagma": {
    "host": [
      "./adapter/claude-hooks",
      "./adapter/harness",
      "./adapter/hook",
      "./adapter/metadata",
      "./adapter/payload",
      "./adapter/provider",
      "./adapter/settings",
      "./adapter/speech",
      "effect",
      "effect/http"
    ]
  }
}
