{
  "envelope": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
        "maxLength": 40,
        "description": "A plugin in Tagma’s format: lowercase letters, digits and inner hyphens, so it names a site and its agents."
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "process": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "entry": {
                "type": "string"
              },
              "resident": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Kept running while the plugin is enabled, rather than started on demand and stopped when idle."
              }
            },
            "required": ["entry"],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "options": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^(?!TAGMA_)[A-Z][A-Z0-9_]*$",
                  "maxLength": 64
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "type": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["string", "number", "boolean", "directory", "file"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sensitive": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "A secret: kept in the key store, masked in what the process answers."
                },
                "required": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "default": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["key", "title", "description"],
              "additionalProperties": false
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "build": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 over each source as its path, a NUL, its byte length, a NUL and its bytes, in the order listed."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["hash", "sources"],
        "additionalProperties": false
      },
      "contributes": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "description": "Contributions by point; every point is declared by the owner that registers it."
      }
    },
    "required": ["id", "title", "version", "build"],
    "additionalProperties": false
  },
  "points": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "maxLength": 40,
            "description": "The agent inside the plugin; Tagma offers it as <plugin>.<id>."
          },
          "path": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+\\.md$",
            "description": "Its definition, a Markdown file with frontmatter, relative to the plugin directory. It names its capabilities; plugin:<plugin> is added to them."
          }
        },
        "required": ["id", "path"],
        "additionalProperties": false
      }
    },
    "beforeBuild": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1,
            "description": "The tool of the plugin’s process Tagma calls before a build from this checkout."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "What the update card shows while the step runs."
          }
        },
        "required": ["tool", "title"],
        "additionalProperties": false
      }
    },
    "launchers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "maxLength": 40,
            "description": "The view it opens in a window, one of contributes.views. The plugin needs no process for it."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "The words of the palette action and the rail button that open the view."
          }
        },
        "required": ["view", "title"],
        "additionalProperties": false
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["tool"],
      "additionalProperties": false
    },
    "on": {
      "type": "object",
      "properties": {
        "ended": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$",
              "description": "The tool Tagma calls when a turn of a thread whose bindings name this plugin under `plugin` ends, with { threadId, runId, status, failureReason }. Its answer confirms the delivery; an error or no answer delivers it again, so it is idempotent by runId."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "panes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "maxLength": 40,
            "description": "The view the section or pane shows, one of contributes.views."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "What the navigation, the palette and the pane header call it."
          },
          "icon": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ui\\/(?:(?!\\.\\.?\\/)[A-Za-z0-9_.-]+\\/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.(?:svg|png|webp|gif|jpg)$",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "description": "An image file inside the plugin’s ui/ directory, served from the plugin’s own origin like its views. Absent: a neutral plugin glyph."
          }
        },
        "required": ["view", "title"],
        "additionalProperties": false
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "minLength": 1,
            "description": "A view of the plugin, one of contributes.views, that a thread may pin above its feed."
          }
        },
        "required": ["view"],
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "A tool of the plugin’s process, named in contributes.tools for agents or own."
          },
          "view": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "maxLength": 40,
            "description": "The view its call shows in the feed, one of contributes.views."
          }
        },
        "required": ["tool", "view"],
        "additionalProperties": false
      }
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The owner-chosen name of this schedule, unique within its owner."
          },
          "everyMs": {
            "type": "integer",
            "minimum": 1000,
            "description": "Milliseconds between runs, at least 1000."
          },
          "tool": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "everyMs", "tool"],
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "maxLength": 40,
            "description": "The view the section or pane shows, one of contributes.views."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "What the navigation, the palette and the pane header call it."
          },
          "icon": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ui\\/(?:(?!\\.\\.?\\/)[A-Za-z0-9_.-]+\\/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.(?:svg|png|webp|gif|jpg)$",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "description": "An image file inside the plugin’s ui/ directory, served from the plugin’s own origin like its views. Absent: a neutral plugin glyph."
          }
        },
        "required": ["view", "title"],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "The tool, as the process lists it."
          },
          "audience": {
            "type": "string",
            "enum": ["agents", "own", "view", "tagma"],
            "description": "agents: offered, deferred, to every agent in a project where the plugin is enabled. own: only to the plugin’s own agents. view: only to the plugin’s views. tagma: called by Tagma alone, for a point that names it."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the tool does, as an agent reads it."
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["object"]
              }
            },
            "required": ["type"],
            "allOf": [
              {
                "type": "object",
                "additionalProperties": {}
              }
            ],
            "description": "The JSON Schema of its input: an object at the root."
          },
          "annotations": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "readOnlyHint": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "destructiveHint": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "idempotentHint": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "openWorldHint": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "The MCP tool annotations; readOnlyHint true lets it run without asking in review mode."
          }
        },
        "required": ["name", "audience", "description", "inputSchema"],
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "maxLength": 40,
            "description": "The view, named within its plugin: lowercase letters, digits and inner hyphens."
          },
          "entry": {
            "type": "string",
            "pattern": "^ui\\/(?:(?!\\.\\.?\\/)[A-Za-z0-9_.-]+\\/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.html$",
            "maxLength": 200,
            "description": "The HTML page of the view inside the plugin’s ui/ directory, e.g. ui/table.html."
          },
          "live": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "true: a view in a tool result keeps running while scrolled away, within the feed’s budget. Absent: it unmounts out of sight."
          },
          "csp": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "connectDomains": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "resourceDomains": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "frameDomains": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "baseUriDomains": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "The outside origins the page may reach, as an MCP Apps CSP declaration: frameDomains for embedded players, resourceDomains for images, media, scripts and styles, connectDomains for fetch and sockets. Absent: the page reaches only its own plugin. An entry that names this machine, a bare address or more than one source is dropped."
          }
        },
        "required": ["id", "entry"],
        "additionalProperties": false
      }
    }
  }
}
