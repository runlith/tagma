{
  "name": "@runlith/highlight",
  "version": "0.1.0",
  "private": true,
  "description": "Shiki code colouring: whole-text tokens, the worker that computes them, and document sessions that recolour from the touched line.",
  "type": "module",
  "exports": {
    "./colours": {
      "types": "./src/colours.ts",
      "browser": "./src/colours.ts",
      "default": "./src/colours.ts"
    },
    "./offThread": {
      "types": "./src/offThread.ts",
      "browser": "./src/offThread.ts",
      "default": "./src/offThread.ts"
    },
    "./session": {
      "types": "./src/session.ts",
      "browser": "./src/session.ts",
      "default": "./src/session.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "test:integration": "testbed bun test --no-isolate $(find src -name '*.itest.ts' | sed 's|^|./|')",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/files": "workspace:*",
    "@runlith/utils": "workspace:*",
    "shiki": "catalog:"
  }
}
