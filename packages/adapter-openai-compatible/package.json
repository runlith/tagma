{
  "name": "@runlith/adapter-openai-compatible",
  "version": "0.1.0",
  "private": true,
  "description": "The built-in adapter of Tagma for OpenAI-compatible servers the operator adds in settings: Ollama, LM Studio, vLLM, OpenRouter and the like.",
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./src/adapter.ts",
      "bun": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/llm": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  }
}
