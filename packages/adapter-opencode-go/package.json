{
  "name": "@runlith/adapter-opencode-go",
  "version": "0.1.0",
  "private": true,
  "description": "The built-in OpenCode Go model provider adapter of Tagma.",
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./src/adapter.ts",
      "bun": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./icon": {
      "types": "./src/icon.ts",
      "browser": "./src/icon.ts",
      "node": "./src/icon.ts",
      "default": "./src/icon.ts"
    },
    "./models/opencodeGo": {
      "types": "./src/models/opencodeGo.ts",
      "browser": "./src/models/opencodeGo.ts",
      "node": "./src/models/opencodeGo.ts",
      "default": "./src/models/opencodeGo.ts"
    },
    "./profiles/opencodeGo": {
      "types": "./src/profiles/opencodeGo.ts",
      "default": "./src/profiles/opencodeGo.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/llm": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/effect-test": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  },
  "tagma": {
    "host": [
      "./models/opencodeGo",
      "./profiles/opencodeGo"
    ]
  }
}
