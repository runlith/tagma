      "svelte": "./src/query-data.ts",
      "default": "./src/query-data.ts"
    },
    "./repo": {
      "types": "./src/repo.ts",
      "browser": "./src/repo.ts",
      "ssr": "./src/repo.ts",
      "svelte": "./src/repo.ts",
      "default": "./src/repo.ts"
    },
    "./test-utils/observe.svelte": {
      "types": "./src/test-utils/observe.svelte.ts",
      "browser": "./src/test-utils/observe.svelte.ts",
      "svelte": "./src/test-utils/observe.svelte.ts",
      "default": "./src/test-utils/observe.svelte.ts"
    },
    "./types": {
      "types": "./src/types.ts",
