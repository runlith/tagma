{
  "name": "@runlith/query",
  "version": "0.1.0",
  "private": true,
  "description": "The data layer over the application graph: repositories as keys, TanStack query-core observers wrapped in runes, a cache leased to its scope, and answers named by the scope that asked.",
  "type": "module",
  "exports": {
    "./builders/keyed": {
      "types": "./src/builders/keyed.ts",
      "browser": "./src/builders/keyed.ts",
      "svelte": "./src/builders/keyed.ts",
      "default": "./src/builders/keyed.ts"
    },
    "./builders/single": {
      "types": "./src/builders/single.ts",
      "browser": "./src/builders/single.ts",
      "svelte": "./src/builders/single.ts",
      "default": "./src/builders/single.ts"
    },
    "./gated.svelte": {
      "types": "./src/gated.svelte.ts",
      "browser": "./src/gated.svelte.ts",
      "svelte": "./src/gated.svelte.ts",
      "default": "./src/gated.svelte.ts"
    },
    "./hydration": {
      "types": "./src/hydration.ts",
      "browser": "./src/hydration.ts",
      "ssr": "./src/hydration.ts",
      "node": "./src/hydration.ts",
      "svelte": "./src/hydration.ts",
      "default": "./src/hydration.ts"
    },
    "./mutation.svelte": {
      "types": "./src/mutation.svelte.ts",
