{
  "name": "@runlith/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./browser": {
      "types": "./src/browser.ts",
      "bun": "./src/browser.ts"
    },
    "./engines": {
      "types": "./src/engines.ts",
      "bun": "./src/engines.ts"
    },
    "./artifacts": {
      "types": "./src/artifacts.ts",
      "bun": "./src/artifacts.ts"
    },
    "./stand": {
      "types": "./src/stand.ts",
      "bun": "./src/stand.ts"
    },
    "./ios": {
      "types": "./src/lanes/ios.ts",
      "bun": "./src/lanes/ios.ts"
    },
    "./touch": {
      "types": "./src/touch.ts",
      "bun": "./src/touch.ts"
    }
  },
  "scripts": {
    "test:e2e": "testbed e2e ./src/guard.e2e.ts ./src/touch.e2e.ts ./src/electron.e2e.ts",
    "test:e2e:ios": "testbed e2e --parallel=1 ./src/lanes/ios.e2e.ts ./src/lanes/ios-contract.e2e.ts",
    "test:integration": "testbed itest --no-isolate",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@runlith/chrome-for-testing": "workspace:*",
    "@runlith/effect-test": "workspace:*",
    "@runlith/file-lock": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "appium-remote-debugger": "18.0.3",
    "effect": "catalog:",
    "playwright-core": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "electron": "catalog:",
    "typescript": "catalog:"
  }
}
