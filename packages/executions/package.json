    },
    "./storedRules": {
      "types": "./src/storedRules.ts",
      "default": "./src/storedRules.ts"
    },
    "./stopLadder": {
      "types": "./src/stopLadder.ts",
      "default": "./src/stopLadder.ts"
    },
    "./protocol/*.test": null,
    "./protocol/*": {
      "types": "./src/protocol/*.ts",
      "browser": "./src/protocol/*.ts",
      "node": "./src/protocol/*.ts",
      "default": "./src/protocol/*.ts"
    },
    "./conformance/*": {
      "types": "./src/conformance/*.ts",
      "default": "./src/conformance/*.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate",
    "test:integration": "testbed itest --no-isolate",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@runlith/effect-test": "workspace:*",
