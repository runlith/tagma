{
  "name": "@runlith/adapter-opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./src/adapter.ts",
      "bun": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./harness": {
      "types": "./src/harness/opencode.ts",
      "bun": "./src/harness/opencode.ts",
      "default": "./src/harness/opencode.ts"
    },
    "./harness/session": {
      "types": "./src/harness/session.ts",
      "bun": "./src/harness/session.ts",
      "default": "./src/harness/session.ts"
    },
    "./runner": {
      "types": "./src/runner/run.ts",
      "bun": "./src/runner/run.ts",
      "default": "./src/runner/run.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "test:integration": "testbed itest --no-isolate",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@opencode/cli": "2.1.3",
    "@opencode/client": "2.1.3",
    "@opencode/plugin": "2.1.3",
    "@runlith/acp": "workspace:*",
    "@runlith/agent": "workspace:*",
    "@runlith/hosted-runner": "workspace:*",
    "@runlith/llm": "workspace:*",
    "@runlith/ndjson-rpc": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/effect-test": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  },
  "tagma": {
    "carried": [
      {
        "package": "@opencode/cli",
        "binary": {
          "platform": "@opencode/cli-{platform}",
          "from": "bin/opencode",
          "to": "bin/opencode.exe"
        }
      }
    ]
  }
}
