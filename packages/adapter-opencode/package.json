{
  "name": "@runlith/adapter-opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./src/adapter.ts",
      "bun": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "bun": "./src/host.ts",
      "default": "./src/host.ts"
    },
    "./environment": {
      "types": "./src/environment.ts",
      "bun": "./src/environment.ts",
      "default": "./src/environment.ts"
    },
    "./selection": {
      "types": "./src/selection.ts",
      "browser": "./src/selection.ts",
      "bun": "./src/selection.ts",
      "default": "./src/selection.ts"
    },
    "./icon": {
      "types": "./src/icon.ts",
      "browser": "./src/icon.ts",
      "bun": "./src/icon.ts",
      "default": "./src/icon.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "test:integration": "testbed bun test --no-isolate $(find src -name '*.itest.ts' | sed 's|^|./|')",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@opencode/cli": "2.1.3",
    "@opencode/client": "2.1.3",
    "@runlith/llm": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/effect-test": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  }
}
