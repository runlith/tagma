{
  "name": "@runlith/execution-host",
  "version": "0.1.0",
  "private": true,
  "description": "Managed executions held by a Rust process and served by Bun and Effect, with native platform I/O and accounting.",
  "type": "module",
  "exports": {
    "./ProcessReader": "./src/ProcessReader.ts",
    "./testing/laneClient": "./src/testing/laneClient.ts",
    "./composition/platform": {
      "types": "./src/composition/platform.ts",
      "bun": "./src/composition/platform.ts"
    }
  },
  "scripts": {
    "build:native": "bun src/composition/nativeBuild.ts",
    "db:generate": "drizzle-kit generate",
    "test": "testbed bun test --no-isolate",
    "test:integration": "bun run build:native && testbed itest --no-isolate",
    "test:native": "bun run build:native && cargo test -j 1 --locked --manifest-path native/Cargo.toml -p execution-platform -p execution-holder --target-dir native/target -- --test-threads=2",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@runlith/bundle": "workspace:*",
    "@runlith/codesign": "workspace:*",
    "@runlith/executions": "workspace:*",
    "@runlith/file-lock": "workspace:*",
    "@runlith/held": "workspace:*",
    "@runlith/performance": "workspace:*",
    "@runlith/sqlite-process": "workspace:*",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/headless": "6.1.0-beta.302",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/agent": "workspace:*",
    "@runlith/agent-tools": "workspace:*",
    "@runlith/effect-test": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
