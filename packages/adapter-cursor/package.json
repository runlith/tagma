{
  "name": "@runlith/adapter-cursor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./src/adapter.ts",
      "bun": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./runner": {
      "types": "./src/runner/run.ts",
      "bun": "./src/runner/run.ts",
      "default": "./src/runner/run.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "test:integration": "testbed bun test --no-isolate $(find src -name '*.itest.ts' | sed 's|^|./|')",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.40",
    "@effect/platform-bun": "catalog:",
    "@runlith/acp": "workspace:*",
    "@runlith/agent": "workspace:*",
    "@runlith/hosted-runner": "workspace:*",
    "@runlith/llm": "workspace:*",
    "@runlith/ndjson-rpc": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/effect-test": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  },
  "tagma": {
    "carried": [
      {
        "package": "@cursor/sdk",
        "bundled": true,
        "platform": [
          "@cursor/sdk-{platform}"
        ]
      }
    ]
  }
}
