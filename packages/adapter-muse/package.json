{
  "name": "@runlith/adapter-muse",
  "version": "0.1.0",
  "private": true,
  "description": "The built-in Muse model provider adapter of Tagma.",
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./src/adapter.ts",
      "bun": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./models/muse": {
      "types": "./src/models/muse.ts",
      "browser": "./src/models/muse.ts",
      "node": "./src/models/muse.ts",
      "default": "./src/models/muse.ts"
    },
    "./profiles/muse": {
      "types": "./src/profiles/muse.ts",
      "default": "./src/profiles/muse.ts"
    },
    "./icon": {
      "types": "./src/icon.ts",
      "browser": "./src/icon.ts",
      "node": "./src/icon.ts",
      "default": "./src/icon.ts"
    },
    "./profiles/museToolSchema": {
      "types": "./src/profiles/museToolSchema.ts",
      "default": "./src/profiles/museToolSchema.ts"
    },
    "./harness": {
      "types": "./src/harness/museCode.ts",
      "bun": "./src/harness/museCode.ts",
      "default": "./src/harness/museCode.ts"
    },
    "./runner": {
      "types": "./src/runner/run.ts",
      "bun": "./src/runner/run.ts",
      "default": "./src/runner/run.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@muse-code/sdk": "1.4.10",
    "@runlith/acp": "workspace:*",
    "@runlith/agent": "workspace:*",
    "@runlith/hosted-runner": "workspace:*",
    "@runlith/llm": "workspace:*",
    "@runlith/mcp": "workspace:*",
    "@runlith/ndjson-rpc": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/effect-test": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  },
  "tagma": {
    "host": [
      "./models/muse",
      "./profiles/muse",
      "./icon",
      "./profiles/museToolSchema"
    ]
  }
}
