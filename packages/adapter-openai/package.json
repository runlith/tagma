{
  "name": "@runlith/adapter-openai",
  "version": "0.1.0",
  "private": true,
  "description": "The built-in OpenAI model provider adapter of Tagma.",
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./src/adapter.ts",
      "bun": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./harness": {
      "types": "./src/harness/codex.ts",
      "bun": "./src/harness/codex.ts",
      "default": "./src/harness/codex.ts"
    },
    "./harness/session": {
      "types": "./src/harness/session.ts",
      "bun": "./src/harness/session.ts",
      "default": "./src/harness/session.ts"
    },
    "./testing/fixtures/fork-rpc.json": "./src/testing/fixtures/fork-rpc.json",
    "./icon": {
      "types": "./src/icon.ts",
      "browser": "./src/icon.ts",
      "node": "./src/icon.ts",
      "default": "./src/icon.ts"
    },
    "./models/openai": {
      "types": "./src/models/openai.ts",
      "browser": "./src/models/openai.ts",
      "node": "./src/models/openai.ts",
      "default": "./src/models/openai.ts"
    },
    "./oauth/vendors/openai": {
      "types": "./src/oauth/vendors/openai.ts",
      "default": "./src/oauth/vendors/openai.ts"
    },
    "./profiles/openai": {
      "types": "./src/profiles/openai.ts",
      "default": "./src/profiles/openai.ts"
    }
  },
  "scripts": {
    "test": "testbed bun test --no-isolate --pass-with-no-tests src",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@runlith/agent": "workspace:*",
    "@runlith/llm": "workspace:*",
    "@runlith/tagma": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@runlith/effect-test": "workspace:*",
    "@runlith/testbed": "workspace:*",
    "@runlith/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  },
  "tagma": {
    "host": [
      "./models/openai",
      "./profiles/openai"
    ]
  }
}
