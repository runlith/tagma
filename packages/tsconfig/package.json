{
  "name": "@runlith/tsconfig",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript configs and the typecheck command for the runlith monorepo.",
  "bin": {
    "runlith-typecheck": "./src/main.ts"
  },
  "files": [
    "base.json",
    "bun.json",
    "library.json",
    "src"
  ],
  "exports": {
    "./base.json": "./base.json",
    "./bun.json": "./bun.json",
    "./library.json": "./library.json"
  },
  "scripts": {
    "test": "testbed bun test --no-isolate ./src",
    "test:integration": "testbed bun test --no-isolate $(find src -name '*.itest.ts' | sed 's|^|./|')",
    "typecheck": "runlith-typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@runlith/effect-test": "workspace:*"
  }
}
