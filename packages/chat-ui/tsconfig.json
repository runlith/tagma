{
  "extends": "@runlith/tsconfig/bun.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": { "@feed/*": ["./src/*"], "@paint": ["./stand/Markdown.svelte"], "@code": ["./stand/Code.svelte"] },
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["svelte", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "stand/**/*.ts", "stand/**/*.svelte"],
  "exclude": ["stand/historical"]
}
