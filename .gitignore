# Throwaway agent probes: measurement harnesses, stub configs, scratch scripts.
# They exist for the length of one investigation and must never reach the index —
# the operator commits his own work while an agent is mid-run.
_probe*
_scratch*

# Review-panel run directories: seat reports and ledgers, local only.
.reviews/

.external/

# Linked worktrees for agent experiments: one checkout per agent, local only.
.worktrees/
